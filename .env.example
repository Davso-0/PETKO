# Configuración SMTP para EmailService.php.
# Copia este archivo como .env y sustituye todos los valores de ejemplo.
KION_SMTP_HOST=smtp.gmail.com
KION_SMTP_PORT=587
KION_SMTP_ENCRYPTION=tls
KION_SMTP_USER=tu_correo@gmail.com
KION_SMTP_PASSWORD=TU_CONTRASENA_DE_APLICACION
KION_MAIL_FROM=tu_correo@gmail.com
KION_MAIL_FROM_NAME="PETKO Vet & Agropecuario"

# Base de datos
KION_DB_HOST=localhost
KION_DB_PORT=3306
KION_DB_NAME=kion
KION_DB_USER=root
KION_DB_PASSWORD=

# Google Identity Services
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID

# Solo para probar-correo.php; no lo expongas públicamente.
KION_TEST_EMAIL=destinatario-de-prueba@example.com